# Python virtual environment — 503 MB، يُعاد إنشاؤها بـ:
#   python -m venv venv && pip install -r requirements.txt
venv/
__pycache__/
*.py[cod]

# Node dependencies — 50 MB، يُعاد إنشاؤها بـ: npm install
node_modules/

# حزم وعجلات مُنزَّلة (يوفّرها pip)
*.whl

# مجموعة البيانات الخام — 144 MB، تتجاوز حد GitHub (100 MB).
# نزّلها من Kaggle: Credit Card Fraud Detection
data/*.csv

# أسرار البيئة (‏.env.example المرفوع هو القالب)
.env
