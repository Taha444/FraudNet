# FraudNet environment variables — copy to .env and fill in

# JWT secret key (CHANGE THIS IN PRODUCTION — use a long random string)
SECRET_KEY=fraudnet-change-this-in-production-use-a-long-random-string

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# JWT token expiry in minutes (default: 480 = 8 hours)
TOKEN_EXPIRE_MINUTES=480

# Frontend API URL (used during Docker build)
VITE_API_URL=http://localhost:8000
