# FraudNet environment variables — copy to .env and fill in.
# Never commit the filled-in .env: it is listed in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing key. Generate a fresh one per environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset the service generates a random key at startup, which means every
# restart invalidates all issued tokens — set it explicitly before deploying.
SECRET_KEY=

# First administrator, created only when the user table is empty. Without both
# values no account is created and nobody can log in. Once the account exists
# these variables are ignored; further users are created by that admin through
# POST /api/auth/register.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────

# Database connection. Defaults to the SQLite file backend/fraudnet.db, which
# is fine for development and single-instance use. Point it at a server-backed
# database for anything concurrent, e.g.:
#   postgresql+psycopg2://user:password@host:5432/fraudnet
# The driver must be installed separately (psycopg2-binary for PostgreSQL).
DATABASE_URL=

# Email for the bootstrapped admin (default: <ADMIN_USERNAME>@fraudnet.local)
ADMIN_EMAIL=

# Allowed CORS origins (comma-separated). Set this to the deployed frontend
# origin — the default only covers local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# JWT token expiry in minutes (default: 480 = 8 hours)
TOKEN_EXPIRE_MINUTES=480

# Frontend API URL (used during the Docker build)
VITE_API_URL=http://localhost:8000
